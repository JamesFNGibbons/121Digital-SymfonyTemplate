{
  "name": "121digital-symfony-starter",
  "version": "1.0.0",
  "description": "121 Digital Symfony Starter Project",
  "scripts": {
    "dev": "yarn watch",
    "build": "yarn build:css && yarn build:js",
    "build:css": "lessc assets/less/app.less public/css/app.css --clean-css",
    "build:js": "webpack --mode=production",
    "watch": "yarn watch:css & yarn watch:js",
    "watch:css": "less-watch-compiler assets/less public/css app.less",
    "watch:js": "webpack --mode=development --watch",
    "install-deps": "yarn install",
    "clean": "rm -rf public/css/* public/js/* public/build/*"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@symfony/webpack-encore": "^2.0.0",
    "css-loader": "^6.0.0",
    "file-loader": "^6.0.0",
    "less": "^4.2.0",
    "less-loader": "^10.2.0",
    "less-plugin-clean-css": "^1.6.0",
    "less-watch-compiler": "^1.16.3",
    "style-loader": "^3.0.0",
    "url-loader": "^4.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.0.0"
  },
  "dependencies": {
    "@121digital/bootstrap": "^5.3.8",
    "@popperjs/core": "^2.11.0",
    "bootstrap-icons": "^1.11.0",
    "core-js": "^3.32.0",
    "jquery": "^3.7.0"
  },
  "keywords": [
    "reg121",
    "homepage",
    "domain",
    "website",
    "platform",
    "symfony",
    "bootstrap"
  ],
  "author": "121 Digital Services Limited",
  "license": "proprietary"
}