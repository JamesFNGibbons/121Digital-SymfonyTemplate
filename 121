#!/bin/bash

# REG 121 Homepage CLI Tool
# A branded command-line interface for managing the REG 121 development environment

# Colors for REG 121 branding
ORANGE='\033[38;5;208m'
WHITE='\033[37m'
BOLD='\033[1m'
RESET='\033[0m'
GREEN='\033[32m'
RED='\033[31m'
YELLOW='\033[33m'
BLUE='\033[34m'

# REG 121 Logo and Branding
show_logo() {
    echo -e "${ORANGE}${BOLD}"
    echo "██████╗ ███████╗ ██████╗ ██╗██████╗  ██╗"
    echo "██╔══██╗██╔════╝██╔════╝███║╚════██╗███║"
    echo "██████╔╝█████╗  ██║  ███╗╚██║ █████╔╝╚██║"
    echo "██╔══██╗██╔══╝  ██║   ██║ ██║██╔═══╝  ██║"
    echo "██║  ██║███████╗╚██████╔╝ ██║███████╗ ██║"
    echo "╚═╝  ╚═╝╚══════╝ ╚═════╝  ╚═╝╚══════╝ ╚═╝"
    echo -e "${RESET}"
}

# Help function
show_help() {
    show_logo
    echo -e "${WHITE}${BOLD}Usage:${RESET} ./121 [COMMAND] [OPTIONS]"
    echo ""
    echo -e "${ORANGE}${BOLD}Available Commands:${RESET}"
    echo ""
    echo -e "${GREEN}  start${RESET}           Start the development environment"
    echo -e "${GREEN}  stop${RESET}            Stop the development environment"
    echo -e "${GREEN}  restart${RESET}         Restart all services"
    echo -e "${GREEN}  destroy${RESET}         Stop and remove all containers and volumes"
    echo -e "${GREEN}  status${RESET}           Show status of all services"
    echo ""
    echo -e "${BLUE}  logs${RESET}             Show logs for all services"
    echo -e "${BLUE}  logs [service]${RESET}    Show logs for specific service (app, nginx, mssql)"
    echo ""
echo -e "${YELLOW}  clear-cache${RESET}     Clear Symfony application cache"
echo -e "${YELLOW}  composer [cmd]${RESET}   Run composer commands in the app container"
echo -e "${YELLOW}  console [cmd]${RESET}   Run Symfony console commands"
echo -e "${YELLOW}  npm [cmd]${RESET}       Run npm commands in the app container"
echo -e "${YELLOW}  build-assets${RESET}    Build frontend assets"
echo -e "${YELLOW}  watch-assets${RESET}    Watch and rebuild assets on changes"
    echo ""
    echo -e "${RED}  db-connect${RESET}       Connect to MSSQL database"
    echo -e "${RED}  db-reset${RESET}          Reset database (recreate with sample data)"
    echo ""
    echo -e "${WHITE}  help${RESET}             Show this help message"
    echo -e "${WHITE}  version${RESET}           Show version information"
    echo ""
    echo -e "${ORANGE}${BOLD}Examples:${RESET}"
    echo "  ./121 start                    # Start all services"
    echo "  ./121 logs app                 # Show application logs"
echo "  ./121 console make:controller  # Create a new controller"
echo "  ./121 composer install         # Install dependencies"
echo "  ./121 npm install              # Install npm dependencies"
echo "  ./121 build-assets             # Build frontend assets"
    echo ""
}

# Version function
show_version() {
    echo -e "${ORANGE}${BOLD}REG 121 Homepage CLI${RESET}"
    echo -e "${WHITE}Version:${RESET} 1.0.0"
    echo -e "${WHITE}Symfony:${RESET} 7.3"
    echo -e "${WHITE}PHP:${RESET} 8.2"
    echo -e "${WHITE}Database:${RESET} MSSQL Server 2019"
    echo ""
}

# Check if Docker is running
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo -e "${RED}${BOLD}Error:${RESET} Docker is not running. Please start Docker Desktop first."
        exit 1
    fi
}

# Start services
start_services() {
    echo -e "${ORANGE}${BOLD}Starting REG 121 development environment...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up"; then
        echo -e "${YELLOW}Some services are already running. Use 'restart' to restart all services.${RESET}"
        docker-compose ps
        return
    fi
    
    docker-compose up -d
    echo ""
    echo -e "${GREEN}${BOLD}✅ REG 121 environment started successfully!${RESET}"
    echo -e "${WHITE}Web Application:${RESET} http://localhost"
    echo -e "${WHITE}Database:${RESET} localhost:1433 (sa/YourStrong@Passw0rd)"
    echo ""
    show_status
}

# Stop services
stop_services() {
    echo -e "${ORANGE}${BOLD}Stopping REG 121 development environment...${RESET}"
    check_docker
    
    docker-compose down
    echo -e "${GREEN}${BOLD}✅ REG 121 environment stopped successfully!${RESET}"
}

# Restart services
restart_services() {
    echo -e "${ORANGE}${BOLD}Restarting REG 121 development environment...${RESET}"
    check_docker
    
    docker-compose restart
    echo -e "${GREEN}${BOLD}✅ REG 121 environment restarted successfully!${RESET}"
    echo ""
    show_status
}

# Destroy everything
destroy_services() {
    echo -e "${RED}${BOLD}⚠️  WARNING: This will destroy all containers and volumes!${RESET}"
    echo -e "${WHITE}This action cannot be undone. All data will be lost.${RESET}"
    echo ""
    read -p "Are you sure you want to continue? (y/N): " -n 1 -r
    echo ""
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${ORANGE}${BOLD}Destroying REG 121 development environment...${RESET}"
        check_docker
        
        docker-compose down -v --remove-orphans
        docker system prune -f
        
        echo -e "${GREEN}${BOLD}✅ REG 121 environment destroyed successfully!${RESET}"
        echo -e "${WHITE}All containers, volumes, and data have been removed.${RESET}"
    else
        echo -e "${YELLOW}Operation cancelled.${RESET}"
    fi
}

# Show status
show_status() {
    echo -e "${ORANGE}${BOLD}REG 121 Service Status:${RESET}"
    echo ""
    docker-compose ps
    echo ""
    
    # Check if services are healthy
    if docker-compose ps | grep -q "Up"; then
        echo -e "${GREEN}${BOLD}✅ Services are running${RESET}"
        
        # Test web connectivity
        if curl -s -o /dev/null -w "%{http_code}" http://localhost | grep -q "200\|404"; then
            echo -e "${GREEN}✅ Web server is accessible${RESET}"
        else
            echo -e "${YELLOW}⚠️  Web server may not be ready yet${RESET}"
        fi
        
        # Test database connectivity
        if docker-compose exec -T mssql /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P YourStrong@Passw0rd -Q "SELECT 1" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ Database is accessible${RESET}"
        else
            echo -e "${YELLOW}⚠️  Database may not be ready yet${RESET}"
        fi
    else
        echo -e "${RED}${BOLD}❌ Services are not running${RESET}"
        echo -e "${WHITE}Run './121 start' to start the environment${RESET}"
    fi
    echo ""
}

# Show logs
show_logs() {
    local service=$1
    
    if [ -z "$service" ]; then
        echo -e "${ORANGE}${BOLD}Showing logs for all REG 121 services...${RESET}"
        docker-compose logs -f
    else
        echo -e "${ORANGE}${BOLD}Showing logs for REG 121 $service service...${RESET}"
        docker-compose logs -f "$service"
    fi
}

# Clear cache
clear_cache() {
    echo -e "${ORANGE}${BOLD}Clearing REG 121 application cache...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app php bin/console cache:clear
        echo -e "${GREEN}${BOLD}✅ Cache cleared successfully!${RESET}"
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
    fi
}

# Composer commands
run_composer() {
    local cmd=$1
    
    if [ -z "$cmd" ]; then
        echo -e "${RED}${BOLD}Error:${RESET} Please specify a composer command"
        echo -e "${WHITE}Example: ./121 composer install${RESET}"
        exit 1
    fi
    
    echo -e "${ORANGE}${BOLD}Running composer $cmd...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app composer "$@"
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# Console commands
run_console() {
    local cmd=$1
    
    if [ -z "$cmd" ]; then
        echo -e "${RED}${BOLD}Error:${RESET} Please specify a console command"
        echo -e "${WHITE}Example: ./121 console make:controller${RESET}"
        exit 1
    fi
    
    echo -e "${ORANGE}${BOLD}Running Symfony console $cmd...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app php bin/console "$@"
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# npm commands
run_npm() {
    local cmd=$1
    
    if [ -z "$cmd" ]; then
        echo -e "${RED}${BOLD}Error:${RESET} Please specify an npm command"
        echo -e "${WHITE}Example: ./121 npm install${RESET}"
        exit 1
    fi
    
    echo -e "${ORANGE}${BOLD}Running npm $cmd...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app npm "$@"
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# Build assets
build_assets() {
    echo -e "${ORANGE}${BOLD}Building REG 121 frontend assets...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app npm run build
        echo -e "${GREEN}${BOLD}✅ Assets built successfully!${RESET}"
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# Watch assets
watch_assets() {
    echo -e "${ORANGE}${BOLD}Watching REG 121 frontend assets...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*app"; then
        docker-compose exec app npm run watch
    else
        echo -e "${RED}${BOLD}❌ Application container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# Database connect
db_connect() {
    echo -e "${ORANGE}${BOLD}Connecting to REG 121 MSSQL database...${RESET}"
    check_docker
    
    if docker-compose ps | grep -q "Up.*mssql"; then
        echo -e "${WHITE}Database connection details:${RESET}"
        echo -e "${WHITE}  Server: localhost:1433${RESET}"
        echo -e "${WHITE}  Database: reg121_homepage${RESET}"
        echo -e "${WHITE}  Username: sa${RESET}"
        echo -e "${WHITE}  Password: YourStrong@Passw0rd${RESET}"
        echo ""
        docker-compose exec mssql /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P YourStrong@Passw0rd
    else
        echo -e "${RED}${BOLD}❌ Database container is not running${RESET}"
        echo -e "${WHITE}Run './121 start' first${RESET}"
        exit 1
    fi
}

# Database reset
db_reset() {
    echo -e "${RED}${BOLD}⚠️  WARNING: This will reset the database and lose all data!${RESET}"
    echo -e "${WHITE}This will recreate the database with sample data.${RESET}"
    echo ""
    read -p "Are you sure you want to continue? (y/N): " -n 1 -r
    echo ""
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${ORANGE}${BOLD}Resetting REG 121 database...${RESET}"
        check_docker
        
        if docker-compose ps | grep -q "Up.*mssql"; then
            # Drop and recreate database
            docker-compose exec mssql /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P YourStrong@Passw0rd -Q "DROP DATABASE IF EXISTS reg121_homepage; CREATE DATABASE reg121_homepage;"
            
            # Run initialization script
            docker-compose exec mssql /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P YourStrong@Passw0rd -d reg121_homepage -i /docker-entrypoint-initdb.d/01-init-database.sql
            
            echo -e "${GREEN}${BOLD}✅ Database reset successfully!${RESET}"
        else
            echo -e "${RED}${BOLD}❌ Database container is not running${RESET}"
            echo -e "${WHITE}Run './121 start' first${RESET}"
            exit 1
        fi
    else
        echo -e "${YELLOW}Operation cancelled.${RESET}"
    fi
}

# Main command handler
case "$1" in
    start)
        start_services
        ;;
    stop)
        stop_services
        ;;
    restart)
        restart_services
        ;;
    destroy)
        destroy_services
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs "$2"
        ;;
    clear-cache)
        clear_cache
        ;;
    composer)
        shift
        run_composer "$@"
        ;;
    console)
        shift
        run_console "$@"
        ;;
    npm)
        shift
        run_npm "$@"
        ;;
    build-assets)
        build_assets
        ;;
    watch-assets)
        watch_assets
        ;;
    db-connect)
        db_connect
        ;;
    db-reset)
        db_reset
        ;;
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        show_version
        ;;
    "")
        show_help
        ;;
    *)
        echo -e "${RED}${BOLD}Error:${RESET} Unknown command '$1'"
        echo -e "${WHITE}Run './121 help' to see available commands${RESET}"
        exit 1
        ;;
esac
