# Execute arbitrary PHP commands in the php container
php_cmd() {
    docker-compose exec php "$@"
}
#!/bin/bash

# REG121 Homepage Development Scripts
# Usage: ./dev-scripts.sh [command]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get current user ID and group ID for volume permissions
export USER_ID=$(id -u)
export GROUP_ID=$(id -g)

print_help() {
    echo -e "${BLUE}REG121 Symfony Development Commands:${NC}"
    echo ""
    echo -e "${GREEN}Setup Commands:${NC}"
    echo "  setup           - Initial setup (build containers, install dependencies)"
    echo "  build           - Build development containers"
    echo "  rebuild         - Rebuild containers from scratch"
    echo ""
    echo -e "${GREEN}Development Commands:${NC}"
    echo "  start           - Start development environment"
    echo "  stop            - Stop development environment"
    echo "  restart         - Restart development environment"
    echo "  logs            - Show container logs"
    echo "  status          - Show container status"
    echo ""
    echo -e "${GREEN}Application Commands:${NC}"
    echo "  shell           - Open shell in app container"
    echo "  symfony         - Run Symfony console commands"
    echo "  console         - Run Symfony console commands (alias for symfony)"
    echo "  composer        - Run Composer commands"
    echo "  yarn            - Run Yarn commands"
    echo "  cache-clear     - Clear Symfony cache"
    echo "  cache-warmup    - Warm up Symfony cache"
    echo ""
    echo -e "${GREEN}Frontend Commands:${NC}"
    echo "  vite-start      - Start Vite dev server"
    echo "  vite-stop       - Stop Vite dev server"
    echo "  assets-build    - Build production assets"
    echo "  assets-watch    - Build assets in watch mode"
    echo ""
    echo -e "${GREEN}Database Commands:${NC}"
    echo "  db-create       - Create database"
    echo "  db-migrate      - Run database migrations"
    echo "  db-reset        - Reset database with fresh data"
    echo "  db-shell        - Open database shell"
    echo ""
    echo -e "${GREEN}Utility Commands:${NC}"
    echo "  clean           - Clean up containers and volumes"
    echo "  permissions     - Fix file permissions"
    echo "  health          - Check system health"
    echo ""
    echo -e "${GREEN}Code Quality Commands:${NC}"
    echo "  cs-fix          - Fix code style issues with PHP CS Fixer"
    echo "  cs-check        - Check code style without fixing"
    echo "  cs-dry-run      - Preview what would be fixed (dry run)"
}

# Setup functions
setup() {
    echo -e "${BLUE}Setting up REG121 Homepage development environment...${NC}"
    
    # Create required directories
    mkdir -p var/cache var/log var/sessions var/mysql
    
    # Build containers
    build
    
    # Start services
    docker-compose up -d db redis mailhog
    
    # Wait for database
    echo -e "${YELLOW}Waiting for database to be ready...${NC}"
    sleep 10
    
    # Start app containers
    docker-compose up -d php nginx node
    
    # Install dependencies
    echo -e "${YELLOW}Installing PHP dependencies...${NC}"
    docker-compose exec php composer install
    
    echo -e "${YELLOW}Installing Node.js dependencies...${NC}"
    docker-compose exec node yarn install
    
    # Build initial assets
    echo -e "${YELLOW}Building initial assets...${NC}"
    docker-compose exec node yarn build
    
    # Setup database
    db-create
    
    # Fix permissions
    permissions
    
    echo -e "${GREEN}Development environment setup complete!${NC}"
    echo -e "${BLUE}Access your application at: http://localhost (nginx)${NC}"
    echo -e "${BLUE}MailHog Web UI at: http://localhost:8025${NC}"
}

build() {
    echo -e "${BLUE}Building development containers...${NC}"
    docker-compose build
}

rebuild() {
    echo -e "${BLUE}Rebuilding containers from scratch...${NC}"
    docker-compose down -v
    docker-compose build --no-cache
}

# Development commands
start() {
    echo -e "${BLUE}Starting development environment...${NC}"
    docker-compose up -d
    echo -e "${GREEN}Development environment started!${NC}"
    echo -e "${BLUE}Application: http://localhost${NC}"
    echo -e "${BLUE}MailHog: http://localhost:8025${NC}"
}

stop() {
    echo -e "${BLUE}Stopping development environment...${NC}"
    docker-compose down
}

restart() {
    stop
    start
}

logs() {
    docker-compose logs -f ${2:-}
}

status() {
    docker-compose ps
}

# Application commands
shell() {
    docker-compose exec php bash
}

symfony_cmd() {
    docker-compose exec php php bin/console "${@:2}"
}

composer_cmd() {
    docker-compose exec php composer "${@:2}"
}

yarn_cmd() {
    docker-compose exec node yarn "${@:2}"
}

cache_clear() {
    echo -e "${BLUE}Clearing Symfony cache...${NC}"
    docker-compose exec php php bin/console cache:clear
    permissions
}

cache_warmup() {
    echo -e "${BLUE}Warming up Symfony cache...${NC}"
    docker-compose exec php php bin/console cache:warmup
    permissions
}

# Frontend commands
vite_start() {
    echo -e "${BLUE}Starting Vite dev server...${NC}"
    docker-compose exec node yarn dev
}

vite_stop() {
    echo -e "${BLUE}Stopping Vite dev server...${NC}"
    # Note: This will need manual stopping with Ctrl+C in the running container
    echo -e "${YELLOW}Use Ctrl+C in the running vite process or restart the node container${NC}"
}

assets_build() {
    echo -e "${BLUE}Building production assets...${NC}"
    docker-compose exec node yarn build
}

assets_watch() {
    echo -e "${BLUE}Building assets in watch mode...${NC}"
    docker-compose exec node yarn watch
}

# Database commands
db_create() {
    echo -e "${BLUE}Creating database...${NC}"
    docker-compose exec php php bin/console doctrine:database:create --if-not-exists
}

db_migrate() {
    echo -e "${BLUE}Running database migrations...${NC}"
    docker-compose exec php php bin/console doctrine:migrations:migrate --no-interaction
}

db_reset() {
    echo -e "${BLUE}Resetting database...${NC}"
    docker-compose exec php php bin/console doctrine:database:drop --force --if-exists
    db_create
    db_migrate
}

db_shell() {
    docker-compose exec db mysql -u root -p reg121_homepage
}

# Utility commands
clean() {
    echo -e "${BLUE}Cleaning up containers and volumes...${NC}"
    docker-compose down -v --remove-orphans
    docker system prune -f
}

permissions() {
    echo -e "${BLUE}Fixing file permissions...${NC}"
    sudo chown -R $USER:$USER var/
    sudo chmod -R 775 var/
}

health() {
    echo -e "${BLUE}Checking system health...${NC}"
    echo -e "${YELLOW}Container Status:${NC}"
    status
    echo ""
    echo -e "${YELLOW}Application Health:${NC}"
    curl -s http://localhost > /dev/null && echo -e "${GREEN}✓ Application responding${NC}" || echo -e "${RED}✗ Application not responding${NC}"
    echo ""
    echo -e "${YELLOW}Database Health:${NC}"
    docker-compose exec db mysqladmin ping -h localhost -u root -proot && echo -e "${GREEN}✓ Database responding${NC}" || echo -e "${RED}✗ Database not responding${NC}"
}

# Code Quality commands
cs_fix() {
    echo -e "${BLUE}Running PHP CS Fixer to fix code style issues...${NC}"
    docker-compose exec php ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose
    echo -e "${GREEN}Code style fixes applied!${NC}"
}

cs_check() {
    echo -e "${BLUE}Checking code style with PHP CS Fixer...${NC}"
    docker-compose exec php ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --verbose
}

cs_dry_run() {
    echo -e "${BLUE}Running PHP CS Fixer dry run (preview mode)...${NC}"
    docker-compose exec php ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --verbose
    echo -e "${YELLOW}This was a preview. Run './121 cs-fix' to apply the changes.${NC}"
}

# Command routing
case "${1:-help}" in
    setup) setup ;;
    build) build ;;
    rebuild) rebuild ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    logs) logs "$@" ;;
    status) status ;;
    shell) shell ;;
    symfony) symfony_cmd "$@" ;;
    console) symfony_cmd "$@" ;;
    composer) composer_cmd "$@" ;;
    yarn) yarn_cmd "$@" ;;
    php) shift; php_cmd "$@" ;;
    cache-clear) cache_clear ;;
    cache-warmup) cache_warmup ;;
    vite-start) vite_start ;;
    vite-stop) vite_stop ;;
    assets-build) assets_build ;;
    assets-watch) assets_watch ;;
    db-create) db_create ;;
    db-migrate) db_migrate ;;
    db-reset) db_reset ;;
    db-shell) db_shell ;;
    clean) clean ;;
    permissions) permissions ;;
    health) health ;;
    cs-fix) cs_fix ;;
    cs-check) cs_check ;;
    cs-dry-run) cs_dry_run ;;
    help|*) print_help ;;
esac